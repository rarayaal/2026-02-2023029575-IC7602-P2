# ==============================================================================
# Variables de entorno para la interfaz de usuario (T33 - Base UI)
# Copie este archivo a .env y configure los valores según su entorno.
# ==============================================================================

# URL base del REST API en Node.js (requerida para peticiones al backend en fases posteriores).
# Sin valor por defecto quemado en el código: si falta, la UI emitirá una advertencia visible.
VITE_API_BASE_URL=http://localhost:3000/api

# Título de la aplicación mostrado en el encabezado (Navbar) y metadatos de la UI
VITE_APP_TITLE=Zonal Cache & Proxy UI

# Entorno de ejecución de la aplicación (development | production | test)
VITE_APP_ENV=development

# Puerto local en el host para servir la interfaz en Docker y servidor de desarrollo (default: 5173)
# Se utiliza el puerto 5173 para evitar colisiones con el REST API de Node.js en el puerto 3000
UI_PORT=5173
