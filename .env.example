# ==============================================================================
# Variables de Entorno del Stack Completo: IC-7602 Proyecto 2
# Copie este archivo a .env y configure los valores según su entorno.
# ==============================================================================

# ==============================================================================
# 1. Frontend (UI - React + Vite + Tailwind + Nginx)
# ==============================================================================
# URL base del REST API en Node.js para peticiones desde el navegador
VITE_API_BASE_URL=http://localhost:3000/api

# Título de la aplicación mostrado en el encabezado (Navbar) y metadatos
VITE_APP_TITLE=Proxy/Caché de Aplicación con Geolocalización

# Entorno de ejecución de la aplicación (development | production | test)
VITE_APP_ENV=development

# Puerto local en el host para servir la interfaz en Docker (default: 5173)
UI_PORT=5173

# ==============================================================================
# 2. Firebase Authentication Web SDK (T-33 a T-39)
# Obtener de Firebase Console: Project Settings > General > Web app
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# 3. REST API en Node.js (node-api / T-25 a T-32, T-40)
# ==============================================================================
API_PORT=3000
NODE_ENV=production
# SEGURIDAD: En produccion restringir CORS exclusivamente al dominio de la UI en Vercel
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173
# SEGURIDAD CRITICA: INTERNAL_SERVICE_TOKEN es el secreto compartido entre el API, Zonal Cache
# y DNS Interceptor. En produccion debe generarse con un valor de alta entropia.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=
# Tiempo de vida de las sesiones en segundos (default 1 hora)
SESSION_TTL_SECONDS=3600
# Rondas de costo bcrypt para contraseñas de URLs protegidas (default 10)
BCRYPT_ROUNDS=10

# Credenciales de cuenta de servicio de Firebase Admin SDK (solo para Firestore).
# REGLA DE SEGURIDAD ESTRICTA: El archivo JSON descargado de Firebase Console (serviceAccount*.json o
# *adminsdk*.json) debe guardarse SIEMPRE FUERA de la carpeta del proyecto/repositorio.
# Copie unicamente los valores 'project_id', 'client_email' y 'private_key' a este archivo .env.
# En FIREBASE_PRIVATE_KEY conserve los saltos de linea como la secuencia de escape literal '\n'.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==============================================================================
# 4. Zonal Cache (GNU C / T-11 a T-15, T-40)
# ==============================================================================
CACHE_PORT=8080
ORIGIN_HOST=origin
ORIGIN_PORT=80
# URL del formulario de login de la UI al que redirige la caché cuando falta sesión (debe ser resoluble por el navegador)
AUTH_UI_URL=http://localhost:5173/cache-login
CONFIG_API_URL=http://api:3000
# SEGURIDAD: Debe coincidir exactamente con INTERNAL_SERVICE_TOKEN del API
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_API_TOKEN=
CONFIG_REFRESH_SECONDS=30
EXPECTED_API_KEY=

# ==============================================================================
# 5. DNS Interceptor (GNU C / T-16 a T-24, T-40)
# ==============================================================================
INTERCEPTOR_UDP_PORT=53
UPSTREAM_DNS_IP=8.8.8.8
UPSTREAM_DNS_PORT=53
CONFIG_DOMAINS=app.local,example.com

# ==============================================================================
# 6. Mock Origin Server (T-40)
# ==============================================================================
ORIGIN_EXPOSE_PORT=8081

# ==============================================================================
# 7. Apache Server y REST API Java - Origenes de prueba (T-22 a T-24, T-40)
# ==============================================================================
APACHE_PORT=8083
JAVA_API_PORT=8082
