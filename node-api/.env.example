# Copiar a .env y completar. El archivo .env no se commitea.
# En Vercel estas mismas variables se definen en Project Settings > Environment Variables.

# Puerto del servidor local (no aplica en Vercel)
PORT=3000

# Cuenta de servicio de Firebase (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La llave va entre comillas y con los saltos de línea escritos como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Secreto compartido con el Zonal Cache y el DNS Interceptor (CONFIG_API_TOKEN en ellos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=
