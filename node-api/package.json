{
  "name": "proxycache-node-api",
  "version": "0.1.0",
  "description": "REST API en Node.js que intermedia entre la UI, las cachés zonales y Firestore (IC-7602 P2)",
  "private": true,
  "type": "module",
  "main": "src/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  }
}
